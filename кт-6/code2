using System;
enum Color
{
    Red,
    Green,
    Blue,
    Yellow,
    Cyan,
    Magenta
}

class Program
{
    static string GetHex(Color color)
    {
        switch (color)
        {
            case Color.Red: return "#FF0000";
            case Color.Green: return "#00FF00";
            case Color.Blue: return "#0000FF";
            case Color.Yellow: return "#FFFF00";
            case Color.Cyan: return "#00FFFF";
            case Color.Magenta: return "#FF00FF";
            default: return "#000000";
        }
    }

    static void Main()
    {
        Console.WriteLine("Red: " + GetHex(Color.Red));
        Console.WriteLine("Blue: " + GetHex(Color.Blue));
        Console.WriteLine("Cyan: " + GetHex(Color.Cyan));
    }
}
