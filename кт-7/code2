using System;
using System.Collections.Generic;

abstract class Animal
{
    public string Name { get; set; } = "";
    public abstract void SayHello();
}

class Dog : Animal
{
    public override void SayHello()
    {
        Console.WriteLine(Name + " : Звук шабаки");
    }
}

class Cat : Animal
{
    public override void SayHello()
    {
        Console.WriteLine(Name + " : Звук жидкости");
    }
}
class Program
{
    static void ProcessAnimals(List<Animal> animals, Action<Animal> action)
    {
        foreach (var animal in animals)
        {
            action(animal);
        }
    }

    static void Main()
    {
        List<Animal> animals = new List<Animal>
        {
            new Dog { Name = "Кибоб" },
            new Cat { Name = "Акрум" }
        };

        Action<Animal> sayHello = a => a.SayHello();

        ProcessAnimals(animals, sayHello);

        Action<object> printObject = obj =>
        {
            Console.WriteLine("Объект: " + obj.ToString());
        };

        ProcessAnimals(animals, printObject);

        Func<Animal> createDog = () => new Dog { Name = "Шабака" };

        Animal a = createDog();
        a.SayHello();
    }
}
