using System;
using System.Collections.Generic;
class Matrix
{
    private double[,] data;
    public Matrix(double[,] data)
    {
        this.data = data;
    }

    public IEnumerable<double> GetRow(int index)
    {
        for (int i = 0; i < data.GetLength(1); i++)
        {
            yield return data[index, i];
        }
    }

    public IEnumerable<double> GetColumn(int index)
    {
        for (int i = 0; i < data.GetLength(0); i++)
        {
            yield return data[i, index];
        }
    }
}
class Program
{
    static void Main()
    {
        double[,] arr =
        {
            {1, 2, 3},
            {4, 5, 6},
            {7, 8, 9}
        };

        Matrix m = new Matrix(arr);

        Console.WriteLine("Строка 1:");
        foreach (var x in m.GetRow(1))
            Console.Write(x + " ");

        Console.WriteLine("\n\nСтолбец 2:");
        foreach (var x in m.GetColumn(2))
            Console.Write(x + " ");
    }
}
