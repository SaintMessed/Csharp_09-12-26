using System;

class Calculator<T> where T : new()
{
    public static T Add(T x, T y)
    {
        dynamic a = x;
        dynamic b = y;
        return (T)(a + b);
    }

    public static T Zero()
    {
        return new T();
    }
}

class Program
{
    static void Main()
    {
        int result = Calculator<int>.Add(5, 3);
        Console.WriteLine("Sum: " + result);

        int zero = Calculator<int>.Zero();
        Console.WriteLine("Zero: " + zero);
    }
}
