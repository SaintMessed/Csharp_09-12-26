using System;
interface IPrintable<T> where T : notnull
{
    void Print();
}

class Student : IPrintable<Student>
{
    public string Name { get; set; } = "";
    public int Age { get; set; }
    public double Grade { get; set; }
    public void Print()
    {
        Console.WriteLine($"Student: {Name}, Age={Age}, Grade={Grade}");
    }
}

struct Vector : IPrintable<Vector>
{
    public int X;
    public int Y;
    public int Z;
    public void Print()
    {
        Console.WriteLine($"Vector: X={X}, Y={Y}, Z={Z}");
    }
}

class Program
{
    static void Main()
    {
        Student s = new Student
        {
            Name = "Иван",
            Age = 20,
            Grade = 4.5
        };

        Vector v = new Vector
        {
            X = 1,
            Y = 2,
            Z = 3
        };

        s.Print();
        v.Print();
    }
}
