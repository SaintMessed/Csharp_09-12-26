using System;

class Program
{
    static void Swap<T>(ref T x, ref T y) where T : struct
    {
        T temp = x;
        x = y;
        y = temp;
    }

    static void Main()
    {
        int a = 5, b = 10;
        Swap(ref a, ref b);
        Console.WriteLine($"int: a={a}, b={b}");

        double x = 1.5, y = 2.5;
        Swap(ref x, ref y);
        Console.WriteLine($"double: x={x}, y={y}");

        bool f = true, t = false;
        Swap(ref f, ref t);
        Console.WriteLine($"bool: f={f}, t={t}");
    }
}
