using System;
class Person
{
    public string Name { get; set; } = "";
}
class Program
{
    static void Swap<T>(ref T x, ref T y) where T : notnull
    {
        T temp = x;
        x = y;
        y = temp;
    }
    static void Main()
    {
        int a = 1, b = 2;
        Swap(ref a, ref b);
        Console.WriteLine($"int: {a}, {b}");
        string s1 = "Hello", s2 = "World";
        Swap(ref s1, ref s2);
        Console.WriteLine($"string: {s1}, {s2}");
        Person p1 = new Person { Name = "Ваня" };
        Person p2 = new Person { Name = "Петяня" };
        Swap(ref p1, ref p2);
        Console.WriteLine($"Person: {p1.Name}, {p2.Name}");
    }
}
